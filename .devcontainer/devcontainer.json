{
  "name": "Build Your PC",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Build Your PC app",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
